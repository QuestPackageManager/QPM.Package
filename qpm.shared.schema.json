{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SharedPackageConfig",
  "description": "Configuration for a shared package.",
  "type": "object",
  "required": [
    "config",
    "env",
    "restoredDependencies"
  ],
  "properties": {
    "config": {
      "description": "Package name",
      "allOf": [
        {
          "$ref": "#/definitions/PackageConfig"
        }
      ]
    },
    "env": {
      "description": "Restored environment variables",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "restoredDependencies": {
      "description": "Restored dependencies",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/SharedDependencyInfo"
      }
    }
  },
  "definitions": {
    "DependencyId": {
      "type": "string"
    },
    "PackageAdditionalData": {
      "type": "object",
      "properties": {
        "author": {
          "description": "Package author",
          "default": "",
          "type": "string"
        },
        "description": {
          "description": "Package description",
          "default": "",
          "type": "string"
        },
        "license": {
          "description": "Package license",
          "default": "",
          "type": "string"
        }
      }
    },
    "PackageCompileOptions": {
      "description": "Additional options for compilation and edits to compilation related files.",
      "type": "object",
      "properties": {
        "cFlags": {
          "description": "Additional C flags to add.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "cppFlags": {
          "description": "Additional C++ flags to add.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "includePaths": {
          "description": "Additional include paths to add, relative to the extern package's shared directory.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "systemIncludes": {
          "description": "Additional system include paths to add, relative to the extern package's shared directory.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "PackageConfig": {
      "description": "Configuration for a package.",
      "type": "object",
      "required": [
        "dependenciesDirectory",
        "id",
        "ndk",
        "sharedDirectory",
        "version"
      ],
      "properties": {
        "additionalData": {
          "description": "Additional package metadata",
          "default": {
            "author": "",
            "description": "",
            "license": ""
          },
          "allOf": [
            {
              "$ref": "#/definitions/PackageAdditionalData"
            }
          ]
        },
        "cmake": {
          "description": "Whether to generate CMake files on restore.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "compileOptions": {
          "description": "Additional compile options for the package.",
          "anyOf": [
            {
              "$ref": "#/definitions/PackageCompileOptions"
            },
            {
              "type": "null"
            }
          ]
        },
        "configVersion": {
          "description": "Config version, defaults to 2.0.0",
          "default": "2.0.0",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "dependencies": {
          "description": "Dependencies for this package",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/PackageDependency"
          }
        },
        "dependenciesDirectory": {
          "description": "Directory where dependencies are restored",
          "type": "string"
        },
        "devDependencies": {
          "description": "Dev dependencies for this package",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/PackageDependency"
          }
        },
        "env": {
          "description": "Environment variables for this package.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "id": {
          "description": "Package ID",
          "allOf": [
            {
              "$ref": "#/definitions/DependencyId"
            }
          ]
        },
        "ndk": {
          "description": "The NDK version range.",
          "type": "string",
          "properties": {
            "format": {
              "title": "String",
              "type": "string"
            }
          }
        },
        "outBinaries": {
          "description": "Output binaries for this package.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "qmodId": {
          "description": "QMod ID for this package.",
          "type": [
            "string",
            "null"
          ]
        },
        "qmodIncludeDirs": {
          "description": "List of directories to search during qmod creation.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qmodIncludeFiles": {
          "description": "List of files to include in the resulting qmod.",
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qmodOutput": {
          "description": "Output path for the qmod.",
          "type": [
            "string",
            "null"
          ]
        },
        "qmodTemplate": {
          "description": "QMod template for this package.",
          "type": [
            "string",
            "null"
          ]
        },
        "qmodUrl": {
          "description": "QMod URL for this package.",
          "type": [
            "string",
            "null"
          ]
        },
        "sharedDirectory": {
          "description": "Directories shared by the package",
          "type": "string"
        },
        "toolchainOut": {
          "description": "Path to generate a toolchain JSON file describing the project setup configuration.",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "description": "Package version",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        },
        "workspace": {
          "description": "Workspace configuration",
          "default": {
            "scripts": {}
          },
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceConfig"
            }
          ]
        }
      }
    },
    "PackageDependency": {
      "description": "Dependency information for a package.",
      "type": "object",
      "required": [
        "versionRange"
      ],
      "properties": {
        "qmodExport": {
          "description": "Whether to include this dependency in the qmod",
          "default": false,
          "type": "boolean"
        },
        "qmodRequired": {
          "description": "QMod required field for this dependency.",
          "type": [
            "boolean",
            "null"
          ]
        },
        "versionRange": {
          "description": "Version range requirement",
          "type": "string",
          "properties": {
            "format": {
              "title": "String",
              "type": "string"
            }
          }
        }
      }
    },
    "SharedDependencyInfo": {
      "description": "Dependency information for a shared package.",
      "type": "object",
      "required": [
        "restoredBinaries",
        "restoredEnv",
        "restoredVersion"
      ],
      "properties": {
        "restoredBinaries": {
          "description": "Binaries for this dependency.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "restoredEnv": {
          "description": "Restored environment variables for the dependency.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "restoredVersion": {
          "description": "Version of the dependency.",
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
        }
      }
    },
    "WorkspaceConfig": {
      "description": "Configuration for the workspace.",
      "type": "object",
      "properties": {
        "scripts": {
          "description": "Scripts associated with the workspace.",
          "default": {},
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}